{
  "version": 2,
  "routes": [
    {
      "src": "/api/tts",
      "dest": "/api/tts.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With, X-Article-Id",
        "Access-Control-Max-Age": "86400"
      }
    }
  ]
}
